#!/sbin/openrc-run
supervisor=supervise-daemon

name="Stalwart (podman)"
description=""

directory="/var/lib/stalwart"
config_directory="/etc/stalwart"

: ${container_opts="-p 9002:8080 -p 10025:25 -p 10465:465 -p 10993:993 -v $directory:/var/lib/stalwart -v $config_directory:/etc/stalwart --userns='keep-id:uid=2000,gid=2000' -e STALWART_PUBLIC_URL='https://auth.nouveauprintemps.org'"}
: ${container_image="docker.io/stalwartlabs/stalwart:v0.16-alpine"}

command=/usr/bin/podman
command_args="run $container_opts --name stalwart --rm $container_image"
command_user=stalwart:stalwart

depend() {
    need net localmount cgroups
    after firewall
    use logger
}

start_pre() {
    checkpath -d -m 755 -o "$command_user" "$directory"
    checkpath -d -m 700 -o "$command_user" "$config_directory"
    checkpath -d -m 700 -o "$command_user" "$config_directory/certs"
}
