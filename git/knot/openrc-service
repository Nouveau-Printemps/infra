#!/sbin/openrc-run
supervisor=supervise-daemon

name="Tangled Knot"
description=""

directory="/var/git"

command=/usr/local/bin/knot
command_args="server"
command_user=git:git

export KNOT_REPO_SCAN_PATH
export KNOT_SERVER_HOSTNAME
export KNOT_SERVER_OWNER
export KNOT_SERVER_DB_PATH
export KNOT_SERVER_LISTEN_ADDR

depend() {
        need net localmount cgroups
        after firewall
}

start_pre() {
    checkpath -d -m 750 -o "$command_user" $KNOT_REPO_SCAN_PATH
    checkpath -f -m 750 -o "$command_user" $KNOT_SERVER_DB_PATH
    checkpath -f -m 640 -o "git:atproto" "/var/log/knot.log"
}
